{
  "type": "object",
  "required": ["rewrites"],
  "properties": {
    "rewrites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["commentIndex", "headline", "summary"],
        "additionalProperties": false,
        "properties": {
          "commentIndex": {
            "type": "integer",
            "description": "0-based index into the reconciledComments array"
          },
          "headline": {
            "type": "string",
            "description": "Rewritten headline (3-12 words)"
          },
          "summary": {
            "type": "string",
            "description": "Rewritten summary (under 50 words)"
          }
        }
      }
    }
  }
}
