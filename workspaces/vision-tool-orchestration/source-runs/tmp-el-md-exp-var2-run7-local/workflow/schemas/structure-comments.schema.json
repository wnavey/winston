{
  "type": "object",
  "required": ["comments"],
  "additionalProperties": false,
  "properties": {
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "status",
          "comment",
          "issue",
          "citation",
          "sheets",
          "applicableArea",
          "resolution",
          "confidence",
          "runCount",
          "totalRuns",
          "isCrossDepartment",
          "crossDepartmentNote",
          "isReviewerAttention",
          "reviewerAttentionNote",
          "sheetReferences",
          "documentReferences",
          "sourceFindings"
        ],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "status": { "type": "string", "enum": ["fail", "not-verifiable"] },
          "comment": { "type": "string" },
          "issue": { "type": "string" },
          "citation": { "type": "string" },
          "sheets": { "type": "string" },
          "applicableArea": { "type": "string" },
          "resolution": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "runCount": { "type": "integer" },
          "totalRuns": { "type": "integer" },
          "isCrossDepartment": { "type": "boolean" },
          "crossDepartmentNote": { "type": ["string", "null"] },
          "isReviewerAttention": { "type": "boolean" },
          "reviewerAttentionNote": { "type": ["string", "null"] },
          "sheetReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["documentId", "sheetNumber", "label"],
              "additionalProperties": false,
              "properties": {
                "documentId": { "type": "string" },
                "sheetNumber": { "type": "integer" },
                "label": { "type": "string" }
              }
            }
          },
          "documentReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["documentId", "label"],
              "additionalProperties": false,
              "properties": {
                "documentId": { "type": "string" },
                "label": { "type": "string" }
              }
            }
          },
          "sourceFindings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["ref", "confidence", "runCount", "totalRuns", "perRunFindings"],
              "additionalProperties": false,
              "properties": {
                "ref": { "type": "string" },
                "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
                "runCount": { "type": "integer" },
                "totalRuns": { "type": "integer" },
                "perRunFindings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["run", "status", "comment", "codeCitations", "applicableAreas", "sheetReferences", "documentReferences"],
                    "additionalProperties": false,
                    "properties": {
                      "run": { "type": "string" },
                      "status": { "type": "string", "enum": ["fail", "not-verifiable"] },
                      "comment": { "type": "string" },
                      "codeCitations": { "type": "array", "items": { "type": "string" } },
                      "applicableAreas": { "type": "array", "items": { "type": "string" } },
                      "sheetReferences": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["documentId", "sheetNumber"],
                          "additionalProperties": false,
                          "properties": {
                            "documentId": { "type": "string" },
                            "sheetNumber": { "type": "integer" }
                          }
                        }
                      },
                      "documentReferences": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["documentId", "label"],
                          "additionalProperties": false,
                          "properties": {
                            "documentId": { "type": "string" },
                            "label": { "type": "string" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
