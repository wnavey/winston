he README to get the project information and document IDs.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":6682,"cache_read_input_tokens":24713,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6682},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"fb743e7b-dade-42fe-a871-055cf9865568","uuid":"87358a24-967f-4c26-bb09-f8bd22a359ff"}
