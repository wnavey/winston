{
  "type": "object",
  "required": ["sections"],
  "properties": {
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "summary", "commentIds"],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "description": "Canonical section name (e.g., 'Storm Drainage', 'Parking Layout')"
          },
          "summary": {
            "type": "string",
            "description": "1-2 sentence summary of the section's main themes and issues"
          },
          "commentIds": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Comment IDs from the manifest, ordered by severity then confidence"
          }
        }
      }
    }
  }
}
