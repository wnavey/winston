{
  "type": "object",
  "properties": {
    "grouping": {
      "type": "string",
      "description": "The grouping ID without file extension (e.g., 'de-4')"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "deficiencyId": {
            "type": "string"
          },
          "agentTrace": {
            "type": "object",
            "description": "Agent-produced reasoning trail for this finding. Populated when the extended schema is active.",
            "required": ["observation", "reasoning", "tools_used"],
            "additionalProperties": false,
            "properties": {
              "observation": {
                "type": "string",
                "description": "1-2 sentences describing what was directly observed in the evidence, without interpretation."
              },
              "reasoning": {
                "type": "string",
                "description": "1-3 sentences explaining how the observation was translated into the chosen status."
              },
              "tools_used": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Names of tools invoked while evaluating this item (e.g. 'vision'). Empty array when no tools were used."
              }
            }
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "not-verifiable", "n/a"]
          },
          "codeCitations": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Code section references applicable to this finding"
          },
          "applicableAreas": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Physical locations on the property where this finding applies"
          },
          "sheetReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["documentId", "sheetNumber"],
              "additionalProperties": false,
              "properties": {
                "documentId": { "type": "string" },
                "sheetNumber": { "type": "integer" }
              }
            }
          },
          "documentReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["documentId", "label"],
              "additionalProperties": false,
              "properties": {
                "documentId": { "type": "string" },
                "label": { "type": "string" }
              }
            }
          },
          "comment": {
            "type": "string",
            "description": "Concise deficiency statement (1-2 sentences) explaining what is wrong or not verifiable; can be empty for pass/n/a items"
          }
        },
        "required": [
          "deficiencyId",
          "agentTrace",
          "status",
          "codeCitations",
          "applicableAreas",
          "sheetReferences",
          "documentReferences",
          "comment"
        ]
      }
    }
  },
  "required": ["grouping", "findings"]
}
