plete citations, applicable locations, and concise deficiency statements."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":12,"cache_creation_input_tokens":1590,"cache_read_input_tokens":75656,"cache_creation":{"ephemeral_5m_input_tokens":1590,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"0d291c25-51de-4c78-8a82-6fde89edc795","uuid":"c7816af6-bf7c-472e-9f7f-ea2bb3ab9b0b"}
