ence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":1769,"cache_read_input_tokens":79116,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1769},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"5781b726-3d4c-4d6b-bc37-a1081a1b178a","uuid":"9fd4edeb-4a58-4e19-9402-6d60fa316ba8"}
