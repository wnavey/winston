-1216-4dee-a89c-178950fa7777","sheetNumber":9},{"documentId":"1144b126-1216-4dee-a89c-178950fa7777","sheetNumber":4}],"documentReferences":[],"comment":"Building elevation sheets with surveyed elevations and locations of overhead conductors are not provided. The site plan shows overhead electric lines at the property edges (Valley View Road frontage and eastern boundary), but no building elevation drawings are included in the plan set demonstrating surveyed conductor locations and measured clearances to building facades, rooflines, or projections."},{"deficiencyId":"EL-1.8","status":"fail","codeCitations":["UCM § 1.10.3"],"applicableAreas":["Buildings 1-8, site plan and section views"],"sheetReferences":[{"documentId":"1144b126-1216-4dee-a89c-178950fa7777","sheetNumber":9},{"documentId":"1144b126-1216-4dee-a89c-178950fa7777","sheetNumber":21}],"documentReferences":[],"comment":"Section and plan view exhibits do not show dimensions from the outer electric conductor to the outermost edge of buildings or building projections for clearance verification. While overhead electric lines are depicted on the site plan, no dimensioned clearance annotations are provided showing distances measured from the outside conductor to building edges."},{"deficiencyId":"EL-1.18","status":"not-verifiable","codeCitations":["UCM § 1.10.6.2"],"applicableAreas":["Proposed driveways, parking areas"],"sheetReferences":[{"documentId":"1144b126-1216-4dee-a89c-178950fa7777","sheetNumber":9},{"documentId":"1144b126-1216-4dee-a89c-178950fa7777","sheetNumber":11}],"documentReferences":[],"comment":"Driveways do not show documented minimum 16-foot vertical clearance (parking without truck traffic) or 18-foot vertical clearance (areas with truck traffic) from lowest point of overhead electric facilities. No surveyed mid-span clearance data or registered surveyor documentation is provided showing conductor heights above proposed driveway grades."},{"deficiencyId":"EL-1.23","status":"not-verifiable","codeCitations":["UCM § 1.10.3"],"applicableAreas":["Entire site plan, areas with overhead electric line routing"],"sheetReferences":[{"documentId":"1144b126-1216-4dee-a89c-178950fa7777","sheetNumber":9},{"documentId":"1144b126-1216-4dee-a89c-178950fa7777","sheetNumber":4}],"documentReferences":[],"comment":"Clearance dimensions are not provided on plans with sufficient clarity to verify whether they are measured from utility pole centerline or from the outside conductor. While overhead electric lines are shown on sheets, no dimension lines with annotations are visible indicating the measurement origin point (conductor vs. pole centerline). Without dimensioned clearances from identified outside conductors, compliance cannot be verified."},{"deficiencyId":"EL-1.31","status":"fail","codeCitations":["UCM § 1.10.3"],"applicableAreas":["Buildings 1-8, driveways, overhead electric facility locations"],"sheetReferences":[{"documentId":"1144b126-1216-4dee-a89c-178950fa7777","sheetNumber":4},{"documentId":"1144b126-1216-4dee-a89c-178950fa7777","sheetNumber":9},{"documentId":"1144b126-1216-4dee-a89c-178950fa7777","sheetNumber":11}],"documentReferences":[],"comment":"Survey by registered surveyor showing pole locations and mid-span clearances is not provided. The existing survey shows overhead electric lines at the property edges, but proposed building finished floor elevations and driveway grades must be verified against mid-span overhead conductor elevations. Without registered surveyor documentation of conductor heights and mid-span clearance data, vertical clearances from buildings and driveways to overhead lines cannot be verified."},{"deficiencyId":"EL-1.37","status":"fail","codeCitations":["ECM § 2.4.1.D","ECM § 2.4.2.C","UCM § 1.10.10.4"],"applicableAreas":["Landscape areas near overhead electric lines on southern and eastern property boundaries"],"sheetReferences":[{"documentId":"1144b126-1216-4dee-a89c-178950fa7777","sheetNumber":31},{"documentId":"1144b126-1216-4dee-a89c-178950fa7777","sheetNumber":35}],"documentReferences":[],"comment":"Proposed trees are not verified to be from the Utility Compatible Shade Trees list per ECM Appendix F. The landscape plan proposes 10 Cedar Elm (mature height 40-50 ft) and 2 Live Oak (mature height 40-80 ft) as primary shade trees—both are large-canopy species that are NOT utility-compatible. Large mitigation trees (marked 'M') are shown adjacent to the southern property boundary where overhead electric lines are located; their species are not identified on the plan. There is no notation verifying that proposed trees within 10 lateral feet of overhead distribution lines are utility-compatible per ECM Appendix F."},{"deficiencyId":"EL-1.46","status":"fail","codeCitations":["UCM § 1.10.2"],"applicableAreas":["Cover sheet or general notes"],"sheetReferences":[{"documentId":"1144b126-1216-4dee-a89c-178950fa7777","sheetNumber":1},{"documentId":"1144b126-1216-4dee-a89c-178950fa7777","sheetNumber":3}],"documentReferences":[],"comment":"Plans do not include required note that owner/contractor must notify Austin Energy at least 48 hours before work begins near high-voltage overhead lines as required by Texas Health & Safety Code Chapter 752, Section 752.003. While a pre-construction safety meeting requirement for transmission facilities is noted, no 48-hour notification requirement note for work near distribution line facilities is present on cover sheet or general notes."}]},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":2223,"cache_read_input_tokens":80092,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2223},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"1e954d11-1eb9-4d3c-b419-4ac7a7240f6a","uuid":"b81b4328-3e50-406d-84da-d6159daf233e"}
