ine (OHE) running along southern property boundary"},{"objectA":"proposed mitigation tree (M) symbol at southern boundary, easternmost location","objectB":"outside conductor of overhead electric line (OHE) running along southern property boundary"}],"applicable_checklist_items":[{"checklist_id":"EL-2.1","checklist_deficiency_text":"Non-utility-compatible trees proposed within 15 lateral feet of overhead electric distribution conductor or equipment"},{"checklist_id":"EL-2.3","checklist_deficiency_text":"Large trees (mature height 40+ feet per ECM Appendix F) proposed within 25 lateral feet of overhead electric distribution conductor or equipment"},{"checklist_id":"EL-2.6","checklist_deficiency_text":"Trees proposed within 10 lateral feet of overhead electric utility pole"},{"checklist_id":"EL-2.14","checklist_deficiency_text":"Trees not shown on landscape plan in relation to overhead electric facilities, preventing clearance verification"}]},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":12,"cache_creation_input_tokens":4597,"cache_read_input_tokens":57146,"cache_creation":{"ephemeral_5m_input_tokens":4597,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"8f27eabf-4e7e-4d33-b3eb-83a00ab44689","uuid":"ee99ecac-24e6-4788-acf7-92633ca699aa"}
