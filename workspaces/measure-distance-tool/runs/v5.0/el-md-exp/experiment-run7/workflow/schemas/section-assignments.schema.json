{
  "type": "object",
  "required": ["sections", "areaAssignments"],
  "additionalProperties": false,
  "properties": {
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sectionName", "comments"],
        "additionalProperties": false,
        "properties": {
          "sectionName": {
            "type": "string",
            "description": "Plain-language section title (e.g., 'Storm Drainage', 'Building Setbacks')"
          },
          "comments": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Comment IDs from the manifest (e.g., '1:0', '14:2')"
          }
        }
      }
    },
    "areaAssignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "area"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Comment ID from the manifest (e.g., '1:0', '14:2')"
          },
          "area": {
            "type": "string",
            "description": "Canonical physical zone name (e.g., 'Site Interior', 'Drainage & Detention')"
          }
        }
      }
    }
  }
}
