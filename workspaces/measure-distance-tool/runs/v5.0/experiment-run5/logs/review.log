sed"],"sheetReferences":[{"documentId":"1144b126-1216-4dee-a89c-178950fa7777","sheetNumber":31},{"documentId":"1144b126-1216-4dee-a89c-178950fa7777","sheetNumber":35}],"documentReferences":[],"comment":"Trees proposed within 10 lateral feet of overhead electric distribution conductors are not verified as being from the Utility Compatible Shade Trees list. Landscape plan (Sheet 31) shows a row of trees planted directly on or immediately adjacent to the overhead electric line (OHE) along the southern boundary. Plant list (Sheet 35) specifies 2 Live Oak and 10 Cedar Elm as shade trees to be planted in this location. These species are not utility-compatible and exceed the 20-foot mature height typically required for utility-compatible trees. No distance clearance dimensions are provided between tree planting locations and the conductor."},{"deficiencyId":"EL-1.46","status":"fail","codeCitations":["UCM § 1.10.2"],"applicableAreas":["Cover sheet general notes"],"sheetReferences":[{"documentId":"1144b126-1216-4dee-a89c-178950fa7777","sheetNumber":1}],"documentReferences":[],"comment":"Plans do not include required note that owner/contractor must notify Austin Energy at least 48 hours before work begins near high-voltage overhead lines. Overhead electric poles and lines exist on the site (documented on existing conditions survey Sheet 4) and construction is proposed; the required 48-hour notification note per Texas Health & Safety Code Chapter 752, Section 752.003 is absent from the cover sheet and general notes."}]},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":1690,"cache_read_input_tokens":79348,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1690},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"2d43314f-ffee-4c09-9531-73169237fb4a","uuid":"11942752-1c