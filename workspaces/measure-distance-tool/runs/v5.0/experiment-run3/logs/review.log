\": \"EL-13.6\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.4 Table 1.10.4\"],\n    \"applicableAreas\": [\"All transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 9}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Transformer type (oil-filled vs. dry-type) is not specified on plans. Building elevations showing windows, doors, or ventilating ducts adjacent to transformers are not provided. Cannot verify 12-foot clearance requirement for oil-filled equipment.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.7\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.4 Table 1.10.4\"],\n    \"applicableAreas\": [\"Transformer 3 (SW area) appears adjacent to sidewalk; others may be near pedestrian walkways\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 9}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Sidewalks are shown on site plan, but clearance dimensions from transformer pads to back of sidewalks are not provided. Cannot verify minimum 2-foot clearance.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.9\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.4 Table 1.10.4\"],\n    \"applicableAreas\": [\"All transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 10}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Fire Protection Plan (Sheet 10) shows fire lanes and two proposed fire hydrants but does not show transformer pad locations or clearance dimensions. Transformer type (oil-filled) is not specified. Cannot verify 20-foot clearance from fire escapes or stairs serving as fire escapes.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.10\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.4 Table 1.10.4\"],\n    \"applicableAreas\": [\"All four transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Transformer access door orientation is not indicated on electrical plan. Cannot determine direction of hot-stick use area or verify 10-foot clearance to open area or adjacent structures in access direction.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.11\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.4 Table 1.10.4\"],\n    \"applicableAreas\": [\"All transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 9}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Transformer access door orientation and site configuration are not documented. No cross-section drawings showing whether transformers face confined spaces (niches, vaults, or areas enclosed on 3+ sides). Cannot determine if 15-foot clearance is required instead of 10-foot.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.12\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"Reviewer Convention\"],\n    \"applicableAreas\": [\"All transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 10}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Two fire hydrants are shown on Fire Protection Plan (Sheet 10), but clearance dimensions from transformer pads to hydrants are not provided on electrical plan. Cannot verify 5-foot clearance from transformer pads to fire hydrants.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.13\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.10.4\", \"ECM Appendix F\"],\n    \"applicableAreas\": [\"All transformer pad locations with proximate vegetation\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 31}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Landscape Plan (Sheet 31) shows trees and shrubs throughout site but does not identify species or utility compatibility status per ECM Appendix F. Specific tree locations relative to transformer pads are not dimensioned. Cannot verify that trees within 10 feet of pads are utility-compatible or that trees within 15 feet of overhead distribution are utility-compatible.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.14\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.10.4\"],\n    \"applicableAreas\": [\"All transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 31}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Landscape Plan does not show specific shrub locations dimensioned relative to transformer pads or identify transformer access door orientation. Cannot verify 10-foot clearance from access door side or 5-foot clearance from other sides.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.15\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.10.4\"],\n    \"applicableAreas\": [\"All transformer pad locations with proximate trees\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 31}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Landscape Plan does not identify trees within 20 feet of transformer pads or show root barrier details. No detail drawings for root barrier specifications (4-foot depth, 5-foot offset from equipment) are provided.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.17\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"Reviewer Convention\"],\n    \"applicableAreas\": [\"All transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 9}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Site plan indicates 41 bicycle parking spaces are provided but specific locations relative to transformer pads are not dimensioned. Cannot verify 5-foot clearance from bike racks to transformers.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.18\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"Reviewer Convention\"],\n    \"applicableAreas\": [\"All transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 9}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Site plan references exterior lighting with full cut-off requirement but light pole locations are not shown dimensioned relative to transformer pads. Cannot verify 5-foot clearance from light poles.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.19\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"Reviewer Convention\"],\n    \"applicableAreas\": [\"All transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 10}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Fire Protection Plan shows designated fire lane loop around site, but clearance dimensions from transformer pads to fire lanes are not provided on electrical plan. Cannot verify 15-foot clearance requirement.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.20\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"Reviewer Convention\"],\n    \"applicableAreas\": [\"All four transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Four transformer pads are shown on electrical plan, but clearance dimensions between them are not provided. Cannot verify 5-foot clearance between separate transformer pads.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.21\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 2.9.1.B.2\"],\n    \"applicableAreas\": [\"All four transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 19}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Water lines are shown on Utility Tap Plan (Sheet 19), but clearance dimensions from transformer pads to water service lines are not provided on electrical plan. Cannot verify 5-foot horizontal clearance.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.22\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 2.9.1.B.2\"],\n    \"applicableAreas\": [\"All four transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 19}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Wastewater lines are shown on Utility Tap Plan (Sheet 19) with 6-inch PVC material and 2.0% minimum slope, but clearance dimensions from transformer pads to wastewater lines are not provided. Cannot verify 5-foot horizontal clearance.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.23\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 2.9.1.B.2\"],\n    \"applicableAreas\": [\"All four transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 19}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Storm drain lines are shown on Utility Tap Plan (Sheet 19), but clearance dimensions from transformer pads to storm drain are not provided. Cannot verify 5-foot horizontal clearance.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.25\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.5.A\"],\n    \"applicableAreas\": [\"All four transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 19}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Underground utilities (water, wastewater, storm drain, electric) are shown on site plan, but clearance dimensions from transformer pads are not provided. Cannot verify 12-inch horizontal and vertical clearance from other underground utilities (except gas).\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.26\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.5.B\"],\n    \"applicableAreas\": [\"All four transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"No cross-section drawings provided showing vertical clearances between transformer pads and other utility lines or building foundations. Cannot verify that transformers or AE underground facilities are not located directly over or under other utilities or customer structures.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.27\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.3\"],\n    \"applicableAreas\": [\"All transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 31}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Overhead electric line is referenced on Landscape Plan near trees, but transformer locations relative to overhead distribution conductors are not dimensioned. Cannot verify 7.5-foot horizontal sky-to-ground clearance from ground to sky.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.28\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.3\"],\n    \"applicableAreas\": [\"All transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Overhead distribution lines may be present on site, but transformer locations and clearances from overhead distribution primary and neutral conductors are not dimensioned. Cannot verify 15-foot radius clearance measured from conductors.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.29\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.4 Table 1.10.4 footnote 3\"],\n    \"applicableAreas\": [\"All transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 9}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"No niche configurations are evident on site plan, and no cross-section drawings showing transformer locations within enclosed areas or building notches are provided. Cannot verify 35-foot vertical clearance requirement for niche service installations.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.31\",\n    \"status\": \"fail\",\n    \"codeCitations\": [\"UCM § 1.10.3\"],\n    \"applicableAreas\": [\"All transformer pad locations with overhead structures or enclosed areas\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 9}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"No cross-section drawings are provided in the site plan set demonstrating vertical clearances from transformer locations to overhead structures, parking garages, or enclosed areas. Vertical clearance compliance cannot be demonstrated.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.32\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.4 Table 1.10.4 footnote 1\"],\n    \"applicableAreas\": [\"All transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 11}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Transformer type (oil-filled vs. dry-type) is not specified on electrical plan. Grading plan is not provided showing surface drainage direction around transformer pads. Cannot verify that liquid flow is directed away from buildings.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.33\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.4 Table 1.10.4 footnote 4\"],\n    \"applicableAreas\": [\"All four transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 2}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Facts.md identifies critical undepicted easements including Greenbelt Access & Use Easement (0.31 ac, NE interior), City of Austin Drainage Easement (0.130 ac, NE corner), and multiple utility easements. Transformer locations relative to these undepicted easement areas cannot be verified. Cannot confirm 100% private property placement without clarifying easement footprints.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.34\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.4 Table 1.10.4 footnote 4\"],\n    \"applicableAreas\": [\"All four transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 2}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Facts.md documents multiple undepicted easements (drainage, water, wastewater, electric) that bound and cross the site. Transformer pad locations are not verified against these easement areas. Cannot confirm transformers are not located in drainage easements, water easements, sewer easements, or electrical easements without AE Design written approval.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.35\",\n    \"status\": \"fail\",\n    \"codeCitations\": [\"UCM § 1.10.3\"],\n    \"applicableAreas\": [\"All four transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 2}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Transformer easements are not shown around any of the four transformer pads on the site plan or plat. No easement widths or boundaries are indicated for Austin Energy accessibility and maintenance requirements.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.36\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.4 Table 1.10.4 footnote 4\"],\n    \"applicableAreas\": [\"All four transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Electrical routing from transformers to meters is shown on Sheet 21, but routing dimensions and property boundaries are not clearly dimensioned to verify 100% private property placement of the electrical service line from transformer to meter.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.37\",\n    \"status\": \"fail\",\n    \"codeCitations\": [\"UCM § 1.5.2.6\", \"UCM § 1.18.0\"],\n    \"applicableAreas\": [\"All four transformer pad locations\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Transformer pad dimensions are not shown on the electrical plan. No reference to or attachment of Austin Energy Design-approved transformer pad detail sheets for the specified service type (single-phase or three-phase) is provided. Pad dimensions cannot be verified against AE Design specifications.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.38\",\n    \"status\": \"not-verifiable\",\n    \"codeCitations\": [\"UCM § 1.10.4 Table 1.10.4\"],\n    \"applicableAreas\": [\"Transformer 1 (NW, adjacent to driveway curve); Transformer 3 (SW, near property line/vehicle route)\"],\n    \"sheetReferences\": [\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 21},\n      {\"documentId\": \"1144b126-1216-4dee-a89c-178950fa7777\", \"sheetNumber\": 9}\n    ],\n    \"documentReferences\": [],\n    \"comment\": \"Transformers 1 and 3 appear to be adjacent to vehicle circulation routes, but clearance dimensions from pad edge to parking areas or drive lanes are not provided. No bollard details or specifications per AE Design equipment pad standards are included.\"\n  },\n  {\n    \"deficiencyId\": \"EL-13.39\",\n    \"status\": \"not-verifiable\",\n    \"co